# Postgres connection string (Coolify-managed Postgres in production).
DATABASE_URL=postgres://user:password@localhost:5432/cahayoyo_cockpit

# Session signing secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-string

# Vault encryption key (AES-256-GCM): base64 for exactly 32 bytes.
# Generate with: openssl rand -base64 32 — set it in the Coolify environment at deploy.
# Never change it once entries exist: those entries become unreadable.
VAULT_ENCRYPTION_KEY=replace-with-a-base64-32-byte-key

# Dev-only seed accounts (scripts/seed-dev.ts) — never set in production.
# Fill the passwords in locally; both must be at least 12 characters.
SEED_ADMIN_EMAIL=admin@cahayoyo.local
SEED_ADMIN_PASSWORD=
SEED_TEST_EMAIL=test@cahayoyo.local
SEED_TEST_PASSWORD=

# Media library uploads. Optional: defaults to ./data/uploads in development;
# production uses /data/uploads on the mounted Docker volume.
UPLOAD_DIR=./data/uploads
